# ──────────────────────────────────────────────────────────────────
# Vera AI Agent — Environment Configuration
# ──────────────────────────────────────────────────────────────────
# Copy this file to .env and fill in values for your environment.
# NEVER commit .env to version control.
# ──────────────────────────────────────────────────────────────────

# ── Application ──────────────────────────────────────────────────
APP_NAME=Vera AI Agent
APP_VERSION=1.0.0
ENVIRONMENT=development
DEBUG=false

# ── Server ───────────────────────────────────────────────────────
HOST=0.0.0.0
PORT=8000
LOG_LEVEL=INFO

# ── LLM Configuration (Phase 2) ─────────────────────────────────
LLM_PROVIDER=
LLM_MODEL_NAME=
LLM_API_KEY=
LLM_TEMPERATURE=0.0
LLM_MAX_TOKENS=1024
LLM_TIMEOUT_SECONDS=30

# ── Dataset ──────────────────────────────────────────────────────
DATASET_BASE_PATH=../dataset
